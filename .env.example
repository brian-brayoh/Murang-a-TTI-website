# Create a free project at https://neon.tech, open it, click "Connect",
# and copy the connection string (the "pooled connection" one) here.
# Production on HostPinnacle (or any Postgres): use its connection string instead, e.g.
#   postgresql://DBUSER:DBPASSWORD@localhost:5432/DBNAME
# The app picks the right driver automatically (Neon vs standard Postgres).
DATABASE_URL="postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

AUTH_SECRET="generate-a-real-secret-with: openssl rand -base64 33"
AUTH_TRUST_HOST="true"
ADMIN_EMAIL="admin@murangatech.ac.ke"
ADMIN_PASSWORD="set-a-real-password"

# Public site URL (used for sitemap/SEO) and optional Google Analytics ID
NEXT_PUBLIC_SITE_URL=https://murangatech.ac.ke
# Shown as "updated by" on the website for this first admin (optional)
ADMIN_NAME=
NEXT_PUBLIC_GA_ID=
# Optional: where uploads are stored (persistent folder in production)
UPLOAD_DIR=

# Vercel showcase only: create a Blob store in Vercel (Storage tab) and paste its token.
# When set, uploads go to Vercel Blob instead of the UPLOAD_DIR folder. Leave empty on a VPS.
BLOB_READ_WRITE_TOKEN=
